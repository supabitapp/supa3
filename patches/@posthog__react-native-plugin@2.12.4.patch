+// Native captures bypass the JS before_send hook. Keep the same error-only privacy boundary.
+private fun supacodeExceptionProperties(properties: Map<String, Any>): Map<String, Any> {
+  val scalarKeys = setOf("\$exception_level", "\$lib", "\$lib_version", "\$app_version", "\$app_build", "\$os", "\$os_version", "\$release", "release", "operation")
+  val result = mutableMapOf<String, Any>("surface" to "mobile", "\$process_person_profile" to false, "\$is_identified" to false)
+  for (key in scalarKeys) {
+    val value = properties[key]
+    if (value is String && value.matches(Regex("^[a-zA-Z0-9._-]{1,128}$"))) result[key] = value
+    else if (value is Number) result[key] = value
+  }
+  result["\$geoip_disable"] = true
+  (properties["\$debug_images"] as? List<*>)?.take(50)?.mapNotNull { supacodeExceptionFields(it) }?.let { result["\$debug_images"] = it }
+  (properties["\$exception_list"] as? List<*>)?.take(5)?.mapNotNull { supacodeExceptionFields(it) }?.let { result["\$exception_list"] = it }
+  return result
+}
+
+private fun supacodeExceptionFields(value: Any?): Map<String, Any>? {
+  val fields = value as? Map<*, *> ?: return null
+  val objects = setOf("stacktrace", "mechanism")
+  val arrays = setOf("frames", "images", "debug_images")
+  val numbers = setOf("lineno", "colno", "image_size", "exception_id", "parent_id", "handled", "synthetic", "in_app")
+  val symbols = setOf("type", "platform", "function", "module", "chunk_id", "debug_id", "code_id", "map_id", "uuid", "instruction_addr", "symbol_addr", "image_addr", "image_vmaddr", "arch", "addr_mode")
+  val result = mutableMapOf<String, Any>()
+  for ((key, item) in fields) {
+    if (key !is String || item == null) continue
+    when {
+      key == "value" -> result[key] = "Exception message omitted"
+      key in objects -> supacodeExceptionFields(item)?.let { result[key] = it }
+      key in arrays -> (item as? List<*>)?.let { if (key == "frames") it.takeLast(50) else it.take(50) }?.mapNotNull { supacodeExceptionFields(it) }?.let { result[key] = it }
+      key in numbers && (item is Number || item is Boolean) -> result[key] = item
+      key in symbols && item is String && item.matches(Regex("^[a-zA-Z0-9_.$:<>() -]{1,128}$")) -> result[key] = item
+      key in setOf("filename", "code_file", "debug_file") && item is String -> {
+        val name = item.substringBefore('?').replace('\\', '/').substringAfterLast('/')
+        if (name.matches(Regex("^[a-zA-Z0-9_.-]+\\.(js|cjs|mjs|hbc|so|dylib|dSYM)$"))) result[key] = name
+      }
+    }
+  }
+  return result
+}
