+// Native captures bypass the JS before_send hook. Keep the same error-only privacy boundary.
+private func supacodeExceptionProperties(_ properties: [String: Any]) -> [String: Any] {
+    let scalarKeys: Set<String> = ["$exception_level", "$lib", "$lib_version", "$app_version", "$app_build", "$os", "$os_version", "$release", "release", "operation"]
+    var result: [String: Any] = ["surface": "mobile", "$process_person_profile": false, "$is_identified": false]
+    for key in scalarKeys {
+        if let value = properties[key] as? String, value.range(of: "^[a-zA-Z0-9._-]{1,128}$", options: .regularExpression) != nil { result[key] = value }
+        else if let value = properties[key] as? NSNumber { result[key] = value }
+    }
+    result["$geoip_disable"] = true
+    if let images = properties["$debug_images"] as? [[String: Any]] {
+        result["$debug_images"] = Array(images.prefix(50)).map { supacodeExceptionFields($0) }
+    }
+    if let exceptions = properties["$exception_list"] as? [[String: Any]] {
+        result["$exception_list"] = Array(exceptions.prefix(5)).map { supacodeExceptionFields($0) }
+    }
+    return result
+}
+
+private func supacodeExceptionFields(_ fields: [String: Any]) -> [String: Any] {
+    let objects: Set<String> = ["stacktrace", "mechanism"]
+    let arrays: Set<String> = ["frames", "images", "debug_images"]
+    let numbers: Set<String> = ["lineno", "colno", "image_size", "exception_id", "parent_id", "handled", "synthetic", "in_app"]
+    let symbols: Set<String> = ["type", "platform", "function", "module", "chunk_id", "debug_id", "code_id", "map_id", "uuid", "instruction_addr", "symbol_addr", "image_addr", "image_vmaddr", "arch", "addr_mode"]
+    var result: [String: Any] = [:]
+    for (key, value) in fields {
+        if key == "value" { result[key] = "Exception message omitted" }
+        else if objects.contains(key), let object = value as? [String: Any] { result[key] = supacodeExceptionFields(object) }
+        else if arrays.contains(key), let array = value as? [[String: Any]] { result[key] = Array(key == "frames" ? array.suffix(50) : array.prefix(50)).map { supacodeExceptionFields($0) } }
+        else if numbers.contains(key), value is NSNumber { result[key] = value }
+        else if symbols.contains(key), let text = value as? String, text.range(of: "^[a-zA-Z0-9_.$:<>() -]{1,128}$", options: .regularExpression) != nil { result[key] = text }
+        else if ["filename", "code_file", "debug_file"].contains(key), let text = value as? String {
