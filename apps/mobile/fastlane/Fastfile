default_platform(:ios)

platform :ios do
  desc "Submit the uploaded production build for review, with manual release after approval"
  lane :submit_review do
    binary = ENV.fetch("MOBILE_BINARY")
    info = FastlaneCore::IpaFileAnalyser.fetch_info_plist_file(binary)
    required_fields = %w[CFBundleIdentifier CFBundleShortVersionString CFBundleVersion]
    unless info && required_fields.all? { |key| !info[key].to_s.empty? }
      UI.user_error!("The submitted IPA must contain its bundle identifier, version, and build number")
    end

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APPLE_API_KEY_ID"),
      issuer_id: ENV.fetch("APPLE_API_ISSUER"),
      key_content: ENV.fetch("APPLE_API_KEY")
    )

    app = Spaceship::ConnectAPI::App.find(info.fetch("CFBundleIdentifier"))
    UI.user_error!("The submitted IPA's app was not found in App Store Connect") unless app
    version = app.get_app_store_versions(
      filter: { platform: "IOS", versionString: info.fetch("CFBundleShortVersionString") },
      includes: "build"
    ).first
    reviewed_states = %w[
      WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE
      PROCESSING_FOR_DISTRIBUTION READY_FOR_DISTRIBUTION
    ]
    if version && reviewed_states.include?(version.app_version_state)
      unless version.build&.version == info.fetch("CFBundleVersion")
        UI.user_error!("This app version already has another build in review or approved")
      end
      unless version.release_type == "MANUAL"
        UI.user_error!("The existing review must use manual release")
      end
      UI.success("This build has already been submitted with manual release")
      next
    end

    # Set release mode directly so deliver can skip metadata and preserve review attachments.
    if version
      version.update(attributes: { releaseType: "MANUAL" })
    else
      version = Spaceship::ConnectAPI.post_app_store_version(
        app_id: app.id,
        attributes: {
          platform: "IOS",
          versionString: info.fetch("CFBundleShortVersionString"),
          releaseType: "MANUAL"
        }
      ).to_models.first
    end
    if app.get_live_app_store_version(platform: "IOS")
      version.get_app_store_version_localizations.each do |localization|
        if localization.whats_new.to_s.strip.empty?
          localization.update(attributes: { whatsNew: "Updates and improvements to Supacode." })
        end
      end
    end

    # Using the submitted IPA lets deliver wait for and select this exact build.
    deliver(
      api_key: api_key,
      ipa: binary,
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
